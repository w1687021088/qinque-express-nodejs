# ================================================================
# Express + Node.js 项目 Codex 规则
# 文件位置: .codex/rules/project.rules
# ================================================================

# ---------- 安全红线：绝对禁止的命令 ----------
# 禁止递归强制删除（防止误删整个项目）
prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "禁止递归强制删除，防止误删重要代码",
)

# 禁止直接操作生产环境数据库
prefix_rule(
    pattern = ["mongosh", "prod"],
    decision = "forbidden",
    justification = "禁止直接操作生产数据库，请通过 DBA 审批流程",
)

prefix_rule(
    pattern = ["psql", "production"],
    decision = "forbidden",
    justification = "禁止直接操作生产数据库，请通过 DBA 审批流程",
)


# ---------- 需要人工确认的操作 ----------

# 执行数据库迁移前必须确认
prefix_rule(
    pattern = ["npm", "run", "migrate"],
    decision = "prompt",
    justification = "数据库迁移操作不可逆，需要人工确认",
)

# 执行 `npm publish` 前必须确认
prefix_rule(
    pattern = ["npm", "publish"],
    decision = "prompt",
    justification = "发布包到 npm registry 需要人工确认版本号",
)

prefix_rule(
    pattern = ["pnpm", "add"],
    decision = "prompt",
    justification = "安装新依赖前需要确认，避免引入漏洞",
)

prefix_rule(
    pattern = ["yarn", "add"],
    decision = "prompt",
    justification = "安装新依赖前需要确认，避免引入漏洞",
)


# ---------- 允许自动执行的操作（无需询问） ----------
# 执行 git push
prefix_rule(
    pattern = ["git", "push"],
    decision = "allow",
    justification = "推送代码到远程仓库",
)

# 运行测试是安全的，可以直接执行
prefix_rule(
    pattern = ["npm", "run", "test"],
    decision = "allow",
    justification = "运行测试是安全的操作",
)

prefix_rule(
    pattern = ["pnpm", "run", "test"],
    decision = "allow",
    justification = "运行测试是安全的操作",
)

prefix_rule(
    pattern = ["npm", "run", "lint"],
    decision = "allow",
    justification = "代码检查是安全的操作",
)

# 启动开发服务器
prefix_rule(
    pattern = ["npm", "run", "dev"],
    decision = "allow",
    justification = "启动开发服务器是安全的",
)

# 查看 Git 状态和日志
prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "查看状态是安全的只读操作",
)

prefix_rule(
    pattern = ["git", "log"],
    decision = "allow",
    justification = "查看日志是安全的只读操作",
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "查看改动是安全的只读操作",
)

# 查看文件内容
prefix_rule(
    pattern = ["cat"],
    decision = "allow",
    justification = "查看文件内容",
)

prefix_rule(
    pattern = ["ls"],
    decision = "allow",
    justification = "列出目录内容",
)

# 修改 package.json
prefix_rule(
    pattern = ["npm", "install"],
    decision = "allow",
    justification = "安装新依赖",
)


# ---------- 项目特定的限制 ----------
# 禁止修改配置目录（除非明确指定）
prefix_rule(
    pattern = ["vim", "config"],
    decision = "prompt",
    justification = "修改配置文件前需要确认",
)

prefix_rule(
    pattern = ["nano", "config"],
    decision = "prompt",
    justification = "修改配置文件前需要确认",
)

# 禁止直接修改 .env 文件
prefix_rule(
    pattern = [".env"],
    decision = "forbidden",
    justification = "禁止直接修改 .env 文件，请通过环境变量管理工具配置",
)
