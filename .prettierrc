{
  "printWidth": 120,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,
  "trailingComma": "none",
  "bracketSpacing": true,
  "jsxBracketSameLine": false,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "htmlWhitespaceSensitivity": "strict",
  "requirePragma": false,
  "insertPragma": false,
  "proseWrap": "never",
  "embeddedLanguageFormatting": "auto",
  "singleAttributePerLine": true
}
