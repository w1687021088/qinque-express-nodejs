{
  "name": "s3",
  "version": "1.0.0",
  "description": "练习 nodejs 项目",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=dev tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "install:ci": "npm ci",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "express",
    "typescript",
    "api"
  ],
  "author": "zjw",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.0.0",
    "helmet": "^8.2.0",
    "morgan": "^1.11.0",
    "mysql2": "^3.22.5",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.10.5",
    "@types/uuid": "^10.0.0",
    "@types/winston": "^2.4.4",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.6.0",
    "prettier": "^3.8.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.62.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
