# 复制为 .env.dev、.env.qa、.env.sit 或 .env.prod 后按环境填写；不得提交真实值。
NODE_ENV=dev
APP_NAME=s3
PORT=3000
API_URL=http://localhost:3000
LOG_LEVEL=debug
SWAGGER_ENABLED=true
# 非开发环境必须配置，多个来源以英文逗号分隔。
CORS_ORIGINS=https://app.example.com

# 请使用至少 32 位的随机字符串；access 与 refresh 密钥必须不同。
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-secret
JWT_REFRESH_EXPIRES_IN=30d

SNOWFLAKE_EPOCH=2026-01-05T00:00:00.000Z
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 当前存储适配保留，后续替换时无需让业务模块读取环境变量。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=replace-me
DB_NAME=app_db
